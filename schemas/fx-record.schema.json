{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date"
    },
    "source_currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "target_currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "rate": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)?$",
      "not": {
        "pattern": "^0+(?:\\.0+)?$"
      }
    }
  },
  "required": [
    "date",
    "source_currency",
    "target_currency",
    "rate"
  ],
  "additionalProperties": false
}
