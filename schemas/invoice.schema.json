{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "doc_id": {
      "type": "string",
      "minLength": 1
    },
    "invoice_id": {
      "type": "string",
      "minLength": 1
    },
    "entity_id": {
      "type": "string",
      "minLength": 1
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "due_at": {
      "type": "string",
      "format": "date-time"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "total_minor": {
      "type": "integer",
      "minimum": 1
    },
    "line_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "unit_price_minor": {
            "type": "integer",
            "minimum": 1
          },
          "total_minor": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "description",
          "quantity",
          "unit_price_minor",
          "total_minor"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "doc_id",
    "invoice_id",
    "entity_id",
    "issued_at",
    "due_at",
    "currency",
    "total_minor",
    "line_items"
  ],
  "additionalProperties": false
}
