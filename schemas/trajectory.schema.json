{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "step": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "action": {
      "type": [
        "object",
        "null",
        "array",
        "string",
        "number",
        "boolean"
      ]
    },
    "observation": {
      "type": "object"
    },
    "reward": {
      "type": "number",
      "minimum": -1,
      "maximum": 1
    },
    "terminated": {
      "type": "boolean"
    },
    "truncated": {
      "type": "boolean"
    }
  },
  "required": [
    "episode_id",
    "step",
    "action",
    "observation",
    "reward",
    "terminated",
    "truncated"
  ],
  "additionalProperties": false
}
